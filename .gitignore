# ChunkPatch repository allowlist
#
# Policy:
#   Ignore everything by default, then explicitly keep only files/directories
#   needed to understand, build, test, document, or maintain the source tree.
#
# This intentionally excludes local caches, build output, logs, analysis output,
# IDE settings, local agent/tool state, archives, crash dumps, and runtime data.

# -----------------------------------------------------------------------------
# Default: ignore every top-level file/directory
# -----------------------------------------------------------------------------
/*

# -----------------------------------------------------------------------------
# Git/repository metadata that belongs in source control
# -----------------------------------------------------------------------------
!/.gitignore
!/.gitattributes

# GitHub Actions / repository automation
!/.github/
!/.github/**

# -----------------------------------------------------------------------------
# Source code, tests, resources, and source-owned assets
# -----------------------------------------------------------------------------
!/src/
!/src/**

# Optional conventional documentation/source-support directories
!/docs/
!/docs/**

# Optional Gradle source logic
!/buildSrc/
!/buildSrc/**

# -----------------------------------------------------------------------------
# Build definition and reproducible Gradle wrapper
# -----------------------------------------------------------------------------
!/build.gradle
!/build.gradle.kts
!/settings.gradle
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat

!/gradle/
!/gradle/**

# -----------------------------------------------------------------------------
# Project/source documentation kept at repository root
# -----------------------------------------------------------------------------
!/*.md
!/LICENSE
!/LICENSE.*
!/LICENSE-*
!/NOTICE
!/NOTICE.*

# -----------------------------------------------------------------------------
# Everything not explicitly unignored above stays excluded.
# Examples intentionally excluded by the default rule:
#
#   /.gradle/          Gradle caches
#   /build/            compiled classes, JARs, reports, test results
#   /bin/              IDE/compiler output
#   /out/              compiler output
#   /classes/          compiler output
#   /run/              Fabric/Minecraft runtime directory
#   /logs/             application/test logs
#   /graphify-out/     Graphify generated reports/cache/index
#   /.vscode/          local VS Code settings
#   /.idea/            local IntelliJ settings
#   /.settings/        Eclipse settings
#   /.claude/          local Claude/agent settings, skills and tool state
#   /saves/            local Minecraft worlds
#   /crash-reports/    runtime crash reports
#   /screenshots/      local screenshots
#   /*.jar             generated/distributed binaries at repository root
#   /*.zip             local archives
#   /hs_err_*.log      JVM fatal-error logs
#   /*.hprof           heap dumps
#   /*.jfr             Flight Recorder captures
# -----------------------------------------------------------------------------
